{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "declaration": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "commonjs",
    "declarationMap": true,
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "typeRoots": [
      "./node_modules/@types",
      "types"
    ], 
    "types": [
      "node",
      "jest"], 
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7"
    ]
  },
  "include": [
    "src/**/*.ts", 
    "src/handlers/w2ui-2.0.es6.js" 
, "src/core/custom-components/table-component/table-component.ts", "tests/webbuilder/rbw-table-component.test.ts"]
}
